# Garage of Utility Stuff (GUS) - environment configuration
# Copy to .env and adjust. All runtime state lives in /data (SQLite, secrets, logs).

# Host port published by docker compose
GUS_PORT=3000

# Public base URL (used for links/emails). Optional in local dev.
# GUS_BASE_URL=http://localhost:3000

# Log level: trace | debug | info | warn | error
# GUS_LOG_LEVEL=info